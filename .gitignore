# Secrets & local env — only *.example templates are tracked
.env
.env.*
!.env*.example

# Company / personal-only overlays (Bedrock accounts, internal gateways, SSO scripts, CA certs).
# Put anything that must never reach GitHub in a *.local / *.local.* file or a local/ directory.
*.local
*.local.*
**/local/
.secretpatterns.local
.aws/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flutter / Dart (genui_agent)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/
genui_agent/dist/
.pub-cache/
.pub/

