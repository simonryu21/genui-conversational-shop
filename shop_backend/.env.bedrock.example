# AWS Bedrock으로 테스트할 때의 개인/회사 전용 오버레이 — 복사해서 .env.local로 저장:
#   cp .env.bedrock.example .env.local
# .env.local은 .env 위에 덮어씌워지며(config.py) .gitignore(.env.*)로 커밋되지 않는다.
# 회사 계정 ID·프로파일명·게이트웨이 주소·키는 반드시 이 파일(.env.local)에만 적는다.
#
# Personal/company overlay for testing via AWS Bedrock — copy to .env.local:
#   cp .env.bedrock.example .env.local
# .env.local overrides .env (config.py) and is git-ignored (.env.*). Keep every company-specific
# value (account IDs, profile names, gateway URLs, keys) ONLY in .env.local.

LLM_PROVIDER=bedrock
BEDROCK_REGION=us-east-1

# 비우면 global.anthropic.claude-opus-5-5 — 계정에 따라 리전 추론 프로파일(us./apac.)이 필요할 수 있음
# Leave empty for global.anthropic.claude-opus-5-5 — some accounts require a regional profile (us./apac.)
CLAUDE_MODEL_ID=

# ── 자격증명 (셋 중 하나) / Credentials (pick one) ───────────────────────
# (a) 명명 프로파일 (aws configure / aws sso login 후)  /  named profile (after aws configure or aws sso login)
AWS_PROFILE=my-company-profile
# (b) 임시 키 직접 지정 (SSO 콘솔 "Command line access" 복사값) / explicit temporary keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# (c) 아무것도 쓰지 않으면 표준 AWS 자격증명 체인(환경변수 → ~/.aws → 인스턴스 역할)
#     nothing set → standard AWS credential chain (env vars → ~/.aws → instance role)

# ── 회사 네트워크 (필요할 때만) / Corporate network (only if needed) ──────
# 사내 Bedrock 게이트웨이·프록시 엔드포인트 (비우면 AWS 공식 엔드포인트)
# Internal Bedrock gateway / proxy endpoint (empty = official AWS endpoint)
# BEDROCK_BASE_URL=https://bedrock-gateway.example.internal
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1
# 사내 CA 번들 (httpx·boto3 모두 인식) / corporate CA bundle (used by httpx and boto3)
# SSL_CERT_FILE=./local/corp-ca.pem
# AWS_CA_BUNDLE=./local/corp-ca.pem

# 데모 언어 기본값 (FE 설정 메뉴가 우선) / default demo language (FE settings menu overrides)
# DEMO_LANGUAGE=ko
