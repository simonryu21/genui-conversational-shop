# 복사해서 .env로 저장 후 실값 입력:  cp .env.example .env
# 개인/회사 전용 값(Bedrock 계정·게이트웨이 등)은 .env.local에 — 예시: .env.bedrock.example (커밋되지 않음)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shop_db

# ── LLM ─────────────────────────────────────────────────────────────
# anthropic (기본): Anthropic API 직결 / bedrock: AWS Bedrock 경유
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# 비우면 공급자별 기본값 (anthropic: claude-opus-5-5 / bedrock: global.anthropic.claude-opus-5-5)
CLAUDE_MODEL_ID=
LLM_EFFORT=medium            # low / medium / high

# bedrock일 때 — 자세한 항목은 .env.bedrock.example 참고 (회사 값은 .env.local에만)
# BEDROCK_REGION=us-east-1
# AWS_PROFILE=default
# BEDROCK_BASE_URL=          # 사내 게이트웨이를 거칠 때만

# ── 데모 언어 ───────────────────────────────────────────────────────
# en (기본) / ko — 모델 응답 언어와 서버 안내 문구. FE 설정(⚙) 메뉴에서 바꾸면 그 값이 우선.
DEMO_LANGUAGE=en

# ── 서버 ────────────────────────────────────────────────────────────
PORT=8010

# ── (선택) 실데이터 수집: 한국소비자원 참가격 openAPI (공공데이터포털, Encoding형 인증키) ──
# 비우면 fetch_seed_data.py가 참가격을 건너뛰고 Open Food Facts만 수집
DATA_GO_KR_API_KEY=
